{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "badminton-api-jp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true }
}
