{
  "name": "badminton-api-jp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A free, no-auth badminton venue API for Japan, inspired by Ramen API",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "graphql": "^16.11.0",
    "hono": "^4.10.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261121.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.50.0"
  },
  "engines": {
    "node": ">=22"
  }
}
